<Window
    x:Class="ApiMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ApiMonitor.Views"
    Title="ApiMonitor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootLayout" Background="Transparent"
          Loaded="OnStartupRootLoaded"
          ActualThemeChanged="OnStartupThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="ApiMonitor">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid x:Name="ShellHost" Grid.Row="1" Background="Transparent"
              Opacity="0" IsHitTestVisible="False">
            <views:MainPage x:Name="RootPageControl" />
        </Grid>
        <!-- UrbanPlanToolbox-style logo-only splash, above a fully initialized shell. -->
        <Grid x:Name="StartupOverlay" Grid.RowSpan="2"
              Background="Transparent"
              Canvas.ZIndex="100"
              AutomationProperties.Name="ApiMonitor startup">
            <Image x:Name="StartupDarkLogo"
                   Source="ms-appx:///Assets/Square310x310Logo.scale-200.png"
                   Width="183" Height="183" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"
                   ImageOpened="OnStartupLogoImageOpened"
                   ImageFailed="OnStartupLogoImageFailed" />
            <Image x:Name="StartupLightLogo"
                   Source="ms-appx:///Assets/Square310x310Logo.scale-200_altform-colorful_theme-light.png"
                   Width="183" Height="183" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   ImageOpened="OnStartupLogoImageOpened"
                   ImageFailed="OnStartupLogoImageFailed" />
        </Grid>
    </Grid>
</Window>
