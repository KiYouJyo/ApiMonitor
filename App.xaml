<Application
    x:Class="ApiMonitor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#666666" />
                    <SolidColorBrush x:Key="AppNavigationSelectedBrush" Color="#E8F2FB" />
                    <SolidColorBrush x:Key="FloatingSurfaceBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#272727" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="AppNavigationSelectedBrush" Color="#12395B" />
                    <SolidColorBrush x:Key="FloatingSurfaceBackgroundBrush" Color="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppNavigationSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FloatingSurfaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
