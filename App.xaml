<Application
    x:Class="ApiMonitor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="#00F4F7F9" />
                    <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="#E5F9F9" />
                    <SolidColorBrush x:Key="ShellNavigationPaneInactiveBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="#E5F9F9" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#EEFFFFFF" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#B8F5F9FC" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#CCD8E2E9" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#666666" />
                    <SolidColorBrush x:Key="AppNavigationSelectedBrush" Color="#D8DCEFF9" />
                    <SolidColorBrush x:Key="FloatingSurfaceBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="#00162027" />
                    <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="#1A2323" />
                    <SolidColorBrush x:Key="ShellNavigationPaneInactiveBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="#1A2323" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#D12C3943" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#B532414B" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#72556975" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="AppNavigationSelectedBrush" Color="#BF204F65" />
                    <SolidColorBrush x:Key="FloatingSurfaceBackgroundBrush" Color="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellNavigationPaneInactiveBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppNavigationSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FloatingSurfaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24,22" />
            </Style>
            <Style x:Key="AppSettingsInnerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSubtleSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
