<UserControl
    x:Class="ApiMonitor.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ApiMonitor.ViewModels"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        AutomationProperties.Name="{Binding Onboarding.StepTitleText, Mode=OneWay}">
        <StackPanel Padding="24,28,24,36" Spacing="20" MaxWidth="840" HorizontalAlignment="Center">

            <StackPanel Spacing="12">
                <Border Width="72" Height="72" CornerRadius="18"
                        Background="{ThemeResource AppCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                        BorderThickness="1" HorizontalAlignment="Left">
                    <Image Source="ms-appx:///Assets/Square71x71Logo.scale-200.png"
                           Width="56" Height="56" Stretch="Uniform" />
                </Border>
                <TextBlock loc:Loc.Key="Onboarding.Title" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <TextBlock
                Text="{Binding Onboarding.StepProgressText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar Minimum="0" Maximum="4" Height="4"
                         Value="{Binding Onboarding.StepIndexForProgress, Mode=OneWay}"
                         AutomationProperties.Name="Onboarding progress" />
            <TextBlock
                Text="{Binding Onboarding.StepTitleText, Mode=OneWay}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                Text="{Binding Onboarding.StepBodyText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- 第一步：欢迎与隐私 -->
            <Border Style="{StaticResource AppCardStyle}" Padding="26,24"
                Visibility="{Binding Onboarding.CurrentStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Onboarding.PrivacyHighlights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        loc:Loc.Key="Onboarding.PrivacyPolicy"
                        Command="{Binding Onboarding.OpenPrivacyPolicyCommand}"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 第二步：添加第一个账户 -->
            <Border Style="{StaticResource AppCardStyle}" Padding="26,24"
                Visibility="{Binding Onboarding.CurrentStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Onboarding.Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:OnboardingProviderRow">
                                <StackPanel Spacing="3" Margin="0,4">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        loc:Loc.Key="Onboarding.AddAccountNow"
                        Command="{Binding Onboarding.AddAccountCommand}"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        loc:Loc.Key="Onboarding.SkipAccountHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 第三步：运行方式 -->
            <Border Style="{StaticResource AppCardStyle}" Padding="26,24"
                Visibility="{Binding Onboarding.CurrentStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Onboarding.RunOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:OnboardingRunOption">
                                <StackPanel Spacing="3" Margin="0,4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind DefaultState}"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        loc:Loc.Key="Onboarding.ConfigureLater"
                        Command="{Binding Onboarding.OpenSettingsCommand}"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 第四步：完成 -->
            <Border Style="{StaticResource AppCardStyle}" Padding="26,24"
                Visibility="{Binding Onboarding.CurrentStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Onboarding.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:OnboardingEntry">
                                <StackPanel Spacing="3" Margin="0,4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 底部操作 -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                <Button
                    loc:Loc.Key="Onboarding.Back"
                    Command="{Binding Onboarding.BackCommand}"
                    Visibility="{Binding Onboarding.ShowBackButton, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button
                    loc:Loc.Key="Onboarding.Next"
                    Command="{Binding Onboarding.NextCommand}"
                    Visibility="{Binding Onboarding.ShowNextButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    loc:Loc.Key="Onboarding.EnterApp"
                    Command="{Binding Onboarding.FinishCommand}"
                    Visibility="{Binding Onboarding.ShowFinishButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    loc:Loc.Key="Onboarding.Skip"
                    Command="{Binding Onboarding.SkipCommand}"
                    HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
