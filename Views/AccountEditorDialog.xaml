<ContentDialog
    x:Class="ApiBalanceMonitor.Views.AccountEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ApiBalanceMonitor.ViewModels"
    xmlns:converters="using:ApiBalanceMonitor.Views.Converters"
    Title="{Binding Title}"
    PrimaryButtonText="保存"
    SecondaryButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{Binding CanSave}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StatusSeverityConverter x:Key="StatusSeverityConverter" />
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="420" MaxWidth="620">
            <ComboBox
                Header="Provider"
                ItemsSource="{Binding Providers}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="ProviderId"
                SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}" />
            <TextBox
                Header="账户显示名称"
                Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="例如：我的 DeepSeek 账户" />
            <PasswordBox
                Header="API Key"
                PasswordChanged="OnApiKeyPasswordChanged"
                PlaceholderText="sk-…" />
            <TextBlock
                Text="已保存凭据：留空则继续使用现有 API Key。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding HasStoredCredential, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="测试连接" Command="{Binding TestCommand}" />
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsTesting}" />
            </StackPanel>

            <InfoBar
                IsOpen="{Binding HasTestResult}"
                Severity="{Binding TestSeverity, Converter={StaticResource StatusSeverityConverter}}"
                Title="{Binding TestTitle}"
                Message="{Binding TestResultText}" />

            <ToggleSwitch
                Header="自动刷新"
                OnContent="开启"
                OffContent="关闭"
                IsOn="{Binding AutoRefreshEnabled, Mode=TwoWay}" />
            <ComboBox
                Header="刷新间隔"
                ItemsSource="{Binding RefreshIntervals}"
                SelectedItem="{Binding RefreshIntervalMinutes, Mode=TwoWay}" />
            <TextBlock
                Text="当前版本仅在应用正在运行时自动刷新。关闭应用后将停止监测，托盘驻留将在后续版本提供。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock Text="低余额阈值" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{Binding ThresholdItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ThresholdEditorItem">
                        <Grid
                            Margin="0,4"
                            ColumnDefinitions="Auto,*,Auto,Auto"
                            ColumnSpacing="12">
                            <TextBlock
                                Text="{x:Bind Currency}"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                OnContent=""
                                OffContent="" />
                            <TextBox
                                Grid.Column="2"
                                Width="110"
                                Text="{x:Bind ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="0.00"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind CurrentBalanceLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind StatusLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="{Binding ValidationMessage}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
