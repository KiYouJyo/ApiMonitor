<ContentDialog
    x:Class="ApiBalanceMonitor.Views.AccountEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApiBalanceMonitor.Views.Converters"
    Title="{Binding Title}"
    PrimaryButtonText="保存"
    SecondaryButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{Binding CanSave}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StatusSeverityConverter x:Key="StatusSeverityConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="380">
        <ComboBox
            Header="Provider"
            ItemsSource="{Binding Providers}"
            DisplayMemberPath="DisplayName"
            SelectedValuePath="ProviderId"
            SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}" />
        <TextBox
            Header="账户显示名称"
            Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="例如：我的 DeepSeek 账户" />
        <PasswordBox
            Header="API Key"
            PasswordChanged="OnApiKeyPasswordChanged"
            PlaceholderText="sk-…" />
        <TextBlock
            Text="已保存凭据：留空则继续使用现有 API Key。"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{Binding HasStoredCredential, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="测试连接" Command="{Binding TestCommand}" />
            <ProgressRing Width="20" Height="20" IsActive="{Binding IsTesting}" />
        </StackPanel>

        <InfoBar
            IsOpen="{Binding HasTestResult}"
            Severity="{Binding TestSeverity, Converter={StaticResource StatusSeverityConverter}}"
            Title="{Binding TestTitle}"
            Message="{Binding TestResultText}" />

        <TextBlock
            Text="{Binding ValidationMessage}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
    </StackPanel>
</ContentDialog>
