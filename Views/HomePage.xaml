<UserControl
    x:Class="ApiMonitor.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ApiMonitor.ViewModels"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StatusSeverityConverter x:Key="StatusSeverityConverter" />
    </UserControl.Resources>

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. 页面标题与版本说明 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{Binding SubtitleText}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                loc:Loc.Key="Home.OpenCompactWindow"
                Command="{Binding OpenCompactWindowCommand}"
                VerticalAlignment="Top" />
        </Grid>

        <!-- 2. 主操作栏：添加账户为醒目主按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding AddAccountCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock loc:Loc.Key="Home.AddAccount" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                loc:Loc.Key="Home.RefreshAll"
                Command="{Binding RefreshAllCommand}" />
            <ProgressRing
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                IsActive="{Binding IsRefreshingAll}" />
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{Binding IsStatusVisible}"
            Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverityConverter}}"
            Title="{Binding StatusTitle}"
            Message="{Binding StatusMessage}" />

        <!-- 3. 账户汇总与筛选（带明确标签） -->
        <Border
            Grid.Row="3"
            Padding="14,10"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock
                        loc:Loc.Key="Home.AccountOverview"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding AccountSummaryText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock
                            loc:Loc.Key="Home.FilterProvider"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            MinWidth="160"
                            ItemsSource="{Binding ProviderFilterOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="ProviderId"
                            SelectedValue="{Binding SelectedProviderFilter, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            loc:Loc.Key="Home.FilterStatus"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            MinWidth="140"
                            ItemsSource="{Binding StatusFilterOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="Filter"
                            SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. 账户卡片列表（统一滚动，卡片自适应高度，不裁切） -->
        <Grid Grid.Row="4">
            <ListView
                x:Name="AccountsList"
                ItemsSource="{Binding FilteredAccounts}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,6" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountListItemViewModel">
                        <Border
                            MinHeight="200"
                            Padding="18,14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <StackPanel Spacing="12">
                                    <!-- 账户标识 -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Text="{x:Bind DisplayName}"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="{x:Bind ProviderDisplayName}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind CredentialModeText}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind HasCredentialModeText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
                                            <TextBlock
                                                Text="{x:Bind StatusKindText, Mode=OneWay}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock
                                                Text="{x:Bind AvailabilityText, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 余额/指标 -->
                                    <ItemsControl ItemsSource="{x:Bind BalanceLines, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:BalanceLine">
                                                <TextBlock
                                                    Text="{x:Bind LineText}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 监测状态 -->
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Bind AutoRefreshStatusText, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind RefreshIntervalText, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Bind LastSuccessLine, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="·"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind NextRefreshText, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 阈值 + 通知 + 暂停状态 -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            Text="{x:Bind ThresholdSummaryText, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsLowBalance, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="{x:Bind ThresholdSummaryText, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsLowBalance, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="{x:Bind NotificationsEnabledText, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind SnoozeSummaryText, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Visibility="{x:Bind HasSnooze, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="{x:Bind LastErrorText, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasLastError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- 操作区（统一命令栏） -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button loc:Loc.Key="Home.Refresh" Command="{x:Bind RefreshCommand}" />
                                            <Button loc:Loc.Key="Home.Edit" Command="{x:Bind EditCommand}" />
                                            <Button loc:Loc.Key="Home.ViewTrends" Command="{x:Bind ViewTrendsCommand}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button loc:Loc.Key="Home.CopyKey" Command="{x:Bind CopyKeyCommand}" />
                                            <Button loc:Loc.Key="Home.History" Command="{x:Bind HistoryCommand}" />
                                            <Button loc:Loc.Key="Home.Delete" Command="{x:Bind DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 通知激活定位高亮 -->
                                <Border
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.16"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsHighlighted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 5. 空状态 -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock
                    loc:Loc.Key="Home.EmptyTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    loc:Loc.Key="Home.EmptyMessage"
                    TextAlignment="Center"
                    MaxWidth="420"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Command="{Binding AddAccountCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock loc:Loc.Key="Home.AddFirstAccount" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    loc:Loc.Key="Home.PrivacyTitle"
                    Message="{Binding HomePrivacyMessage}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock loc:Loc.Key="Home.Loading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
