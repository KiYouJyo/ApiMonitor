<UserControl
    x:Class="ApiMonitor.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApiMonitor.Views.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Padding="28,20,28,24"
            Spacing="16"
            MaxWidth="720"
            HorizontalAlignment="Left">

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 1. 通知区域与启动 -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="通知区域与启动" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="隐藏到通知区域后，余额自动刷新将继续运行。选择“退出 ApiMonitor”才会完全结束程序。"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="退出 ApiMonitor"
                            Command="{Binding TraySettings.ExitApplicationCommand}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <TextBlock Text="关闭主窗口时：" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons
                        MaxColumns="2"
                        SelectedIndex="{Binding TraySettings.CloseBehaviorIndex, Mode=TwoWay}">
                        <x:String>隐藏到通知区域</x:String>
                        <x:String>退出 ApiMonitor</x:String>
                    </RadioButtons>

                    <ToggleSwitch
                        IsOn="{Binding TraySettings.StartWithWindows, Mode=TwoWay}"
                        IsEnabled="{Binding TraySettings.IsStartupTaskBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                        <ToggleSwitch.Header>
                            <StackPanel Spacing="2">
                                <TextBlock Text="登录 Windows 时启动 ApiMonitor" />
                                <TextBlock
                                    Text="启用后，ApiMonitor 将在登录时驻留通知区域，不自动弹出主窗口。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ToggleSwitch.Header>
                    </ToggleSwitch>

                    <TextBlock
                        Text="{Binding TraySettings.StartupTaskStatusText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding TraySettings.HasStartupTaskStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 2. 余额提醒 -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="余额提醒" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding NotificationSettings.LocalOnlyExplanationText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Header="启用余额系统提醒"
                        OnContent="开启"
                        OffContent="关闭"
                        IsOn="{Binding NotificationSettings.BalanceNotificationsEnabled, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock
                            Text="默认重复提醒间隔"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding NotificationSettings.RepeatOptions}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Hours"
                            SelectedValue="{Binding NotificationSettings.DefaultRepeatIntervalHours, Mode=TwoWay}" />
                    </Grid>
                    <ToggleSwitch
                        Header="余额恢复提醒"
                        OnContent="开启"
                        OffContent="关闭"
                        IsOn="{Binding NotificationSettings.RecoveryNotificationsEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Content="发送测试通知"
                            Command="{Binding NotificationSettings.SendTestCommand}" />
                        <Button
                            Content="打开 Windows 通知设置"
                            Command="{Binding NotificationSettings.OpenWindowsNotificationSettingsCommand}" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding NotificationSettings.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding NotificationSettings.HasStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 3. 应用信息（简单，不做复杂“关于”页） -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="应用信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding SubtitleText}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding SupportedProvidersText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        NavigateUri="https://github.com/KiYouJyo/ApiMonitor"
                        Content="GitHub 项目" />
                    <HyperlinkButton
                        NavigateUri="https://github.com/KiYouJyo/ApiMonitor/blob/main/PRIVACY.md"
                        Content="隐私政策" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
