<UserControl
    x:Class="ApiMonitor.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Padding="28,20,28,24"
            Spacing="16"
            MaxWidth="720"
            HorizontalAlignment="Left">

            <TextBlock loc:Loc.Key="Settings.Title" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 1. 通知区域与启动 -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                Background="{ThemeResource AppCardBackgroundBrush}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Key="Settings.TraySection" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                loc:Loc.Key="Settings.TrayDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            loc:Loc.Key="Settings.ExitApplication"
                            Command="{Binding TraySettings.ExitApplicationCommand}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <TextBlock loc:Loc.Key="Settings.CloseBehavior" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons
                        MaxColumns="2"
                        SelectedIndex="{Binding TraySettings.CloseBehaviorIndex, Mode=TwoWay}">
                        <x:String>隐藏到通知区域</x:String>
                        <x:String>退出 ApiMonitor</x:String>
                    </RadioButtons>

                    <ToggleSwitch
                        IsOn="{Binding TraySettings.StartWithWindows, Mode=TwoWay}"
                        IsEnabled="{Binding TraySettings.IsStartupTaskBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                        <ToggleSwitch.Header>
                            <StackPanel Spacing="2">
                                <TextBlock loc:Loc.Key="Settings.StartWithWindowsHeader" />
                                <TextBlock
                                    loc:Loc.Key="Settings.StartWithWindowsDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ToggleSwitch.Header>
                    </ToggleSwitch>

                    <TextBlock
                        Text="{Binding TraySettings.StartupTaskStatusText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding TraySettings.HasStartupTaskStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 2. 余额提醒 -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                Background="{ThemeResource AppCardBackgroundBrush}">
                <StackPanel Spacing="14">
                    <TextBlock loc:Loc.Key="Settings.NotificationSection" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding NotificationSettings.LocalOnlyExplanationText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        loc:Loc.Key="Settings.EnableNotifications"
                        OnContent="开启"
                        OffContent="关闭"
                        IsOn="{Binding NotificationSettings.BalanceNotificationsEnabled, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock
                            loc:Loc.Key="Settings.RepeatInterval"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding NotificationSettings.RepeatOptions}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Hours"
                            SelectedValue="{Binding NotificationSettings.DefaultRepeatIntervalHours, Mode=TwoWay}" />
                    </Grid>
                    <ToggleSwitch
                        loc:Loc.Key="Settings.RecoveryNotifications"
                        OnContent="开启"
                        OffContent="关闭"
                        IsOn="{Binding NotificationSettings.RecoveryNotificationsEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            loc:Loc.Key="Settings.SendTestNotification"
                            Command="{Binding NotificationSettings.SendTestCommand}" />
                        <Button
                            loc:Loc.Key="Settings.OpenNotificationSettings"
                            Command="{Binding NotificationSettings.OpenWindowsNotificationSettingsCommand}" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding NotificationSettings.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding NotificationSettings.HasStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 3. 外观与语言（v0.6.0） -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                Background="{ThemeResource AppCardBackgroundBrush}">
                <StackPanel Spacing="14">
                    <TextBlock loc:Loc.Key="Settings.AppearanceSection" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock
                            loc:Loc.Key="Settings.Theme"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding AppearanceSettings.ThemeOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding AppearanceSettings.SelectedTheme, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock
                            loc:Loc.Key="Settings.Language"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding AppearanceSettings.LanguageOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding AppearanceSettings.SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock
                        loc:Loc.Key="Settings.AppearanceDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding AppearanceSettings.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding AppearanceSettings.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 4. 数据管理（v0.6.0：便携备份导出/导入） -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                Background="{ThemeResource AppCardBackgroundBrush}">
                <StackPanel Spacing="14">
                    <TextBlock loc:Loc.Key="Settings.DataSection" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding DataManagement.DescriptionText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            loc:Loc.Key="Settings.ExportBackup"
                            Command="{Binding DataManagement.ExportBackupCommand}" />
                        <Button
                            loc:Loc.Key="Settings.ImportBackup"
                            Command="{Binding DataManagement.ImportBackupCommand}" />
                        <Button
                            loc:Loc.Key="Settings.OpenDataFolder"
                            Command="{Binding DataManagement.OpenDataFolderCommand}" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding DataManagement.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding DataManagement.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 5. 应用信息（链接迁移到“关于”页） -->
            <Border
                Padding="18,14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                Background="{ThemeResource AppCardBackgroundBrush}">
                <StackPanel Spacing="6">
                    <TextBlock loc:Loc.Key="Settings.AppInfoSection" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding SubtitleText}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding SupportedProvidersText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        NavigateUri="https://github.com/KiYouJyo/ApiMonitor"
                        loc:Loc.Key="Settings.GitHubLink" />
                    <HyperlinkButton
                        NavigateUri="https://github.com/KiYouJyo/ApiMonitor/blob/main/PRIVACY.md"
                        loc:Loc.Key="Settings.PrivacyLink" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
