<UserControl
    x:Class="ApiMonitor.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ApiMonitor.Views.Controls"
    xmlns:viewModels="using:ApiMonitor.ViewModels"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与副标题 -->
        <StackPanel Spacing="4">
            <TextBlock loc:Loc.Key="Insights.Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                loc:Loc.Key="Insights.Subtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 选择区：账户 / 指标 / 时间范围 -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,*"
            ColumnSpacing="16"
            RowSpacing="10">
            <StackPanel Spacing="4">
                <TextBlock
                    loc:Loc.Key="Insights.Account"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    MinWidth="180"
                    ItemsSource="{Binding Insights.Accounts}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding Insights.SelectedAccount, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    loc:Loc.Key="Insights.Metric"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{Binding Insights.Metrics}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding Insights.SelectedMetric, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock
                    loc:Loc.Key="Insights.TimeRange"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    MinWidth="150"
                    ItemsSource="{Binding Insights.Ranges}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding Insights.SelectedRange, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button
                    loc:Loc.Key="Insights.ExportCsv"
                    Command="{Binding Insights.ExportCsvCommand}"
                    Visibility="{Binding Insights.HasData, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <!-- 主要内容区：图表 + 摘要 + 历史表 -->
        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 空状态 -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding Insights.HasData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock
                    Text="{Binding Insights.EmptyMessage}"
                    TextAlignment="Center"
                    MaxWidth="480"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Visibility="{Binding Insights.HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- 趋势图（轻量本地控件） -->
                    <Border
                        Padding="14,10"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                        Background="{ThemeResource AppCardBackgroundBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="{Binding Insights.SelectedMetric.DisplayName, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <controls:TrendChartControl
                                Points="{Binding Insights.TrendPoints, Mode=OneWay}"
                                Unit="{Binding Insights.SelectedMetric.Unit, Mode=OneWay}"
                                ChartSummary="{Binding Insights.ChartSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- 当前值 / 区间变化 / 估算 -->
                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="10"
                        RowSpacing="10">
                        <Border
                            Padding="14,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            Background="{ThemeResource AppCardBackgroundBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Key="Insights.CurrentValue" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Insights.CurrentValueText, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="14,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            Background="{ThemeResource AppCardBackgroundBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Key="Insights.ChangeInRange" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Insights.ChangeInRangeText, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="14,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            Background="{ThemeResource AppCardBackgroundBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Key="Insights.DailyConsumption" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Insights.DailyConsumptionText, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="3"
                            Padding="14,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            Background="{ThemeResource AppCardBackgroundBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Key="Insights.EstimatedDaysLeft" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Insights.EstimatedDaysLeftText, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock
                        Text="{Binding Insights.EstimateExplanationText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- v0.9.0：服务账户成功率 -->
                    <TextBlock
                        Text="{Binding Insights.SuccessRateText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Insights.HasSuccessRate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 历史数据表（可折叠；屏幕阅读器用户不依赖图形） -->
            <StackPanel Grid.Row="2" Spacing="6">
                <ToggleButton
                    x:Name="HistoryToggle"
                    loc:Loc.Key="Insights.ShowHistory"
                    Checked="OnHistoryToggleChanged"
                    Unchecked="OnHistoryToggleChanged"
                    HorizontalAlignment="Left" />
                <ListView
                    x:Name="HistoryList"
                    Visibility="Collapsed"
                    MaxHeight="300"
                    ItemsSource="{Binding Insights.HistoryRows}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="110,70,*,110,90,60,60">
                                <TextBlock loc:Loc.Key="Insights.ColTime" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" loc:Loc.Key="Insights.ColProvider" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" loc:Loc.Key="Insights.ColAccount" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" loc:Loc.Key="Insights.ColMetric" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" loc:Loc.Key="Insights.ColValue" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" loc:Loc.Key="Insights.ColUnit" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" loc:Loc.Key="Insights.ColSource" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:InsightsHistoryRow">
                            <Grid ColumnDefinitions="110,70,*,110,90,60,60" ColumnSpacing="6">
                                <TextBlock Text="{x:Bind TimeText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ProviderId}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind AccountDisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind MetricDisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ValueText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Unit}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" Text="{x:Bind SourceText}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>

        <ProgressRing
            Grid.Row="3"
            Width="24"
            Height="24"
            IsActive="{Binding Insights.IsLoading}"
            HorizontalAlignment="Left" />
    </Grid>
</UserControl>
