<UserControl
    x:Class="ApiMonitor.Views.AboutPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ApiMonitor.ViewModels"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid Padding="24,18,24,36" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="CompactAbout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ProductCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="CapabilityCard.(Grid.Row)" Value="1" />
                            <Setter Target="CapabilityCard.(Grid.Column)" Value="0" />
                            <Setter Target="CapabilityCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="PrivacyCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="LinksCard.(Grid.Row)" Value="1" />
                            <Setter Target="LinksCard.(Grid.Column)" Value="0" />
                            <Setter Target="LinksCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="DiagnosticsCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HealthCard.(Grid.Row)" Value="1" />
                            <Setter Target="HealthCard.(Grid.Column)" Value="0" />
                            <Setter Target="HealthCard.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideAbout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ProductCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="CapabilityCard.(Grid.Row)" Value="0" />
                            <Setter Target="CapabilityCard.(Grid.Column)" Value="1" />
                            <Setter Target="CapabilityCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="PrivacyCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="LinksCard.(Grid.Row)" Value="0" />
                            <Setter Target="LinksCard.(Grid.Column)" Value="1" />
                            <Setter Target="LinksCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="DiagnosticsCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="HealthCard.(Grid.Row)" Value="0" />
                            <Setter Target="HealthCard.(Grid.Column)" Value="1" />
                            <Setter Target="HealthCard.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="18" MaxWidth="1080" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6" Margin="0,0,0,8">
                <TextBlock loc:Loc.Key="About.Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock loc:Loc.Key="About.Tagline" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="AboutSectionGrid1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border x:Name="ProductCard" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Image Source="ms-appx:///Assets/Square71x71Logo.scale-200.png" Width="64" Height="64" AutomationProperties.Name="ApiMonitor" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding About.ProductName}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock loc:Loc.Key="About.Tagline" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding About.DisplayVersionText}" />
                        <TextBlock Text="{Binding About.PackageVersionText}" />
                        <TextBlock Text="{Binding About.DistributionChannelText}" />
                        <TextBlock Text="{Binding About.UpdateSourceText}" />
                        <TextBlock Text="{Binding About.ArchitectureText}" />
                        <TextBlock Text="{Binding About.PackageIdentityText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding About.PublisherText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding About.PackageFamilyText}" TextWrapping="Wrap" />
                        <TextBlock loc:Loc.Key="About.License" />
                        <TextBlock loc:Loc.Key="About.Copyright" />
                    </StackPanel>
                </Border>

                <Border x:Name="CapabilityCard" Grid.Column="1" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Key="About.CapabilitiesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding About.ProviderCountText}" />
                        <ItemsControl ItemsSource="{Binding About.Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:AboutProviderRow">
                                    <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock loc:Loc.Key="About.CapabilitiesSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding About.CurrentLanguageText}" />
                        <TextBlock Text="{Binding About.CurrentThemeText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Key="About.UpdateSectionTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock loc:Loc.Key="About.UpdateDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding About.DistributionChannelText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button loc:Loc.Key="About.CheckUpdates" Command="{Binding About.CheckUpdatesCommand}" />
                        <Button loc:Loc.Key="About.InstallUpdate" Command="{Binding About.InstallAvailableUpdateCommand}" Visibility="{Binding About.HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource AccentButtonStyle}" />
                        <Button loc:Loc.Key="About.OpenReleasePage" Command="{Binding About.OpenReleasePageCommand}" Visibility="{Binding About.HasUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <ProgressRing Width="20" Height="20" IsActive="{Binding About.IsCheckingUpdates}" HorizontalAlignment="Left" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding About.UpdateInstallProgress}" Visibility="{Binding About.HasUpdateInstallProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding About.UpdateStatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding About.HasUpdateStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Grid x:Name="AboutSectionGrid2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border x:Name="PrivacyCard" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Key="About.PrivacyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{Binding About.PrivacyItems}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="LinksCard" Grid.Column="1" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Key="About.LinksTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{Binding About.Links}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:AboutLinkRow">
                                    <Button Content="{x:Bind Title}" Command="{Binding ElementName=Root, Path=DataContext.OpenLinkCommand}" CommandParameter="{x:Bind}" Margin="0,2" HorizontalAlignment="Left" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AboutSectionGrid3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border x:Name="DiagnosticsCard" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Loc.Key="About.DiagnosticsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Key="About.DiagnosticsDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Button loc:Loc.Key="About.CopyDiagnostics" Command="{Binding About.CopyDiagnosticsCommand}" HorizontalAlignment="Left" />
                        <Button loc:Loc.Key="About.OpenDataFolder" Command="{Binding About.OpenDataFolderCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border x:Name="HealthCard" Grid.Column="1" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Loc.Key="About.HealthSectionTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock loc:Loc.Key="About.HealthDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button loc:Loc.Key="About.RunHealthChecks" Command="{Binding About.RunHealthChecksCommand}" />
                            <Button loc:Loc.Key="About.OpenSupport" Command="{Binding About.OpenSupportCommand}" />
                        </StackPanel>
                        <ProgressRing Width="20" Height="20" IsActive="{Binding About.IsRunningHealthChecks}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding About.OverallHealthText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding About.HasHealthResults, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding About.HealthChecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:HealthCheckRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <TextBlock Text="{x:Bind StatusText}" FontWeight="SemiBold" MinWidth="64" />
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
