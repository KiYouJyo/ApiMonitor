<Window
    x:Class="ApiMonitor.Views.CompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services"
    Title="ApiMonitor">

    <Grid x:Name="RootGrid" Padding="16,12" RowSpacing="8">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock
                Text="ApiMonitor"
                Style="{StaticResource SubtitleTextBlockStyle}"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="打开主窗口"
                Command="{Binding OpenMainWindowCommand}" />
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto,*,Auto"
            ColumnSpacing="8"
            Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
            <ComboBox
                Header="账户"
                ItemsSource="{Binding AccountOptions}"
                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                MinWidth="130"
                MaxWidth="170"
                HorizontalAlignment="Stretch" />
            <ComboBox
                Grid.Column="1"
                Header="指标"
                ItemsSource="{Binding MetricOptions}"
                SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"
                MinWidth="80"
                MaxWidth="100"
                HorizontalAlignment="Stretch" />
        </Grid>

        <!-- 无账户空状态 -->
        <StackPanel
            Grid.Row="1"
            Spacing="6"
            Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock loc:Loc.Key="Compact.EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button
                Content="打开主窗口"
                Command="{Binding OpenMainWindowCommand}"
                HorizontalAlignment="Left" />
        </StackPanel>

        <!-- 余额数字为视觉重点 -->
        <TextBlock
            Grid.Row="2"
            Text="{Binding BalanceText}"
            Style="{StaticResource TitleTextBlockStyle}"
            FontSize="32"
            FontWeight="Bold"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,4,0,0" />

        <StackPanel
            Grid.Row="3"
            Spacing="2"
            HorizontalAlignment="Center"
            Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock loc:Loc.Key="Compact.StatusPrefix" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock loc:Loc.Key="Compact.LastSuccessPrefix" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding LastSuccessText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="{Binding RefreshStatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding NextRefreshText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 无余额记录空状态 -->
        <TextBlock
            Grid.Row="3"
            loc:Loc.Key="Compact.NoSnapshot"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalAlignment="Center"
            Visibility="{Binding HasSnapshot, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <InfoBar
            Grid.Row="4"
            IsOpen="{Binding HasError}"
            Severity="Error"
            Title="刷新失败"
            Message="{Binding ErrorText}" />

        <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
            <Button loc:Loc.Key="Compact.RefreshButton" Command="{Binding RefreshCommand}" />
            <ToggleSwitch
                Grid.Column="1"
                loc:Loc.Key="Compact.AlwaysOnTop"
                IsOn="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                OnContent="开"
                OffContent="关" />
            <ProgressRing
                Grid.Column="2"
                Width="20"
                Height="20"
                IsActive="{Binding IsBusy}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
