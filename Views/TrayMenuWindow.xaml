<Window x:Class="ApiMonitor.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <!-- Same WinUI 3 surface, semantic brushes, spacing and row geometry as UrbanPlanToolbox. -->
    <Border x:Name="RootLayout"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            KeyDown="OnKeyDown">
        <Border.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#12000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1F000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="TraySeparatorStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Style>
            </ResourceDictionary>
        </Border.Resources>
        <StackPanel x:Name="ItemsHost" Spacing="0" />
    </Border>
</Window>