<UserControl
    x:Class="ApiMonitor.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ApiMonitor.ViewModels"
    xmlns:converters="using:ApiMonitor.Views.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StatusSeverityConverter x:Key="StatusSeverityConverter" />
    </UserControl.Resources>

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="ApiMonitor" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{Binding SubtitleText}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="打开紧凑窗口"
                Command="{Binding OpenCompactWindowCommand}"
                VerticalAlignment="Top"
                ToolTipService.ToolTip="打开始终置顶的紧凑余额窗口" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{Binding IsStatusVisible}"
            Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverityConverter}}"
            Title="{Binding StatusTitle}"
            Message="{Binding StatusMessage}" />

        <Grid Grid.Row="3">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock
                    Text="还没有账户"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="添加 DeepSeek 或 OpenRouter 账户，查看各指标余额。"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    Content="添加账户"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Command="{Binding AddAccountCommand}" />
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="隐私说明"
                    Message="API Key 保存在 Windows 安全凭据存储（Credential Locker）中，只用于请求对应 Provider 的官方接口；普通配置和余额快照仅保存在本机应用数据目录。" />
            </StackPanel>

            <ListView
                x:Name="AccountsList"
                ItemsSource="{Binding FilteredAccounts}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountListItemViewModel">
                        <Border
                            Margin="0,0,0,12"
                            Padding="16,12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ProviderDisplayName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            IsActive="{x:Bind IsRefreshing, Mode=OneWay}" />
                                        <Button Content="刷新" Command="{x:Bind RefreshCommand}" />
                                        <Button Content="复制密钥" Command="{x:Bind CopyKeyCommand}" />
                                        <Button Content="编辑" Command="{x:Bind EditCommand}" />
                                        <Button Content="删除" Command="{x:Bind DeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind StatusKindText, Mode=OneWay}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ProviderDisplayName, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="状态：" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind AvailabilityText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind AutoRefreshStatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind RefreshIntervalText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind LastSuccessLine, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind NextRefreshText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock
                                            Text="{x:Bind ThresholdSummaryText, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsLowBalance, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind ThresholdSummaryText, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsLowBalance, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <Button Grid.Column="1" Content="历史记录" Command="{x:Bind HistoryCommand}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind BalanceLines, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:BalanceLine">
                                                <TextBlock Text="{x:Bind LineText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Text="{x:Bind LastErrorText, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Visibility="{x:Bind HasLastError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                            <Border
                                CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0.18"
                                Visibility="{x:Bind IsHighlighted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="正在加载本地数据…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 通知区域与启动设置（v0.4.0） -->
        <!-- 多账户汇总与筛选（v0.5.0） -->
        <Border
            Grid.Row="2"
            Padding="14,10"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <TextBlock
                    Text="{Binding AccountSummaryText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Content="刷新全部账户"
                        Command="{Binding RefreshAllCommand}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsRefreshingAll}" />
                </StackPanel>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="150"
                    ItemsSource="{Binding ProviderFilterOptions}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="ProviderId"
                    SelectedValue="{Binding SelectedProviderFilter, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="3"
                    MinWidth="120"
                    ItemsSource="{Binding StatusFilterOptions}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Filter"
                    SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- 通知区域与启动设置（v0.4.0） -->
        <Border
            Grid.Row="4"
            Padding="16,14"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="通知区域与启动" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="ApiMonitor 正在通知区域运行。隐藏到通知区域后，余额自动刷新将继续运行；选择“退出 ApiMonitor”才会完全结束程序。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="退出 ApiMonitor"
                        Command="{Binding TraySettings.ExitApplicationCommand}"
                        VerticalAlignment="Top" />
                </Grid>

                <TextBlock Text="关闭主窗口时：" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <RadioButtons
                    MaxColumns="2"
                    SelectedIndex="{Binding TraySettings.CloseBehaviorIndex, Mode=TwoWay}">
                    <x:String>隐藏到通知区域</x:String>
                    <x:String>退出 ApiMonitor</x:String>
                </RadioButtons>

                <ToggleSwitch
                    IsOn="{Binding TraySettings.StartWithWindows, Mode=TwoWay}"
                    IsEnabled="{Binding TraySettings.IsStartupTaskBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="登录 Windows 时启动 ApiMonitor" />
                            <TextBlock
                                Text="启用后，ApiMonitor 将在登录时驻留通知区域，不自动弹出主窗口。"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                MaxWidth="420" />
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>

                <TextBlock
                    Text="{Binding TraySettings.StartupTaskStatusText, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="{Binding TraySettings.HasStartupTaskStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
