<UserControl
    x:Class="ApiMonitor.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ApiMonitor.Views"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    xmlns:loc="using:ApiMonitor.Services">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <converters:PageVisibilityConverter x:Key="PageVisibilityConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="AppPaneBackgroundBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="AppPaneBackgroundBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="AppPaneBackgroundBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Auto"
        OpenPaneLength="270"
        CompactPaneLength="48"
        CompactModeThresholdWidth="920"
        ExpandedModeThresholdWidth="1280"
        AlwaysShowHeader="False"
        SelectionChanged="OnNavigationSelectionChanged"
        Loaded="OnRootNavigationLoaded"
        Background="{ThemeResource AppShellBackgroundBrush}">
        <NavigationView.MenuItems>
            <NavigationViewItem loc:Loc.Key="Nav.Home" Tag="Home">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem loc:Loc.Key="Nav.Insights" Tag="Insights">
                <NavigationViewItem.Icon><SymbolIcon Symbol="FourBars" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem loc:Loc.Key="Nav.Settings" Tag="Settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem loc:Loc.Key="Nav.About" Tag="About">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Background="{ThemeResource AppShellBackgroundBrush}">
            <views:HomePage x:Name="HomePageControl" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Home}" />
            <views:InsightsPage x:Name="InsightsPageControl" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Insights}" />
            <views:SettingsPage x:Name="SettingsPageControl" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}" />
            <views:AboutPage x:Name="AboutPageControl" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=About}" />
            <views:OnboardingPage x:Name="OnboardingPageControl" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Onboarding}" />
        </Grid>
    </NavigationView>
</UserControl>
