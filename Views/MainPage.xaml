<UserControl
    x:Class="ApiMonitor.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ApiMonitor.Views"
    xmlns:converters="using:ApiMonitor.Views.Converters">

    <UserControl.Resources>
        <converters:PageVisibilityConverter x:Key="PageVisibilityConverter" />
    </UserControl.Resources>

    <!--
      主窗口导航外壳（v0.5.0 验收前修正）：
      只承载 主页 / 设置 两个页面，两页共享同一个 MainViewModel，
      不创建第二份账户状态、不重启调度器、不重复订阅事件。
    -->
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavigationSelectionChanged"
        Loaded="OnRootNavigationLoaded">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="主页" Tag="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="Settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <views:HomePage
                x:Name="HomePageControl"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Home}" />
            <views:SettingsPage
                x:Name="SettingsPageControl"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}" />
        </Grid>
    </NavigationView>
</UserControl>
