<Window
    x:Class="ApiMonitor.Views.FloatingBalanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    Title="">

    <Border
        x:Name="SingleRootSurface"
        Width="168"
        Height="168"
        Padding="14"
        CornerRadius="18"
        Background="{ThemeResource FloatingSurfaceBackgroundBrush}">
        <Border.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </Border.Resources>
        <Grid
            x:Name="ContentGrid"
            RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock
                Grid.Row="0"
                Text="{Binding AccountName}"
                Foreground="{ThemeResource AppPrimaryTextBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                MaxWidth="140" />
            <TextBlock
                Grid.Row="1"
                Text="{Binding ProviderName}"
                Foreground="{ThemeResource AppSecondaryTextBrush}"
                FontSize="12"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                MaxWidth="140" />
            <Grid
                Grid.Row="2"
                ColumnDefinitions="Auto,Auto"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding BalanceText}"
                    Foreground="{ThemeResource AppPrimaryTextBrush}"
                    FontSize="{Binding AmountFontSize}"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding UnitText}"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Margin="4,6,0,0"
                    TextTrimming="None" />
            </Grid>
            <TextBlock
                Grid.Row="3"
                Text="{Binding StatusText}"
                Foreground="{ThemeResource AppPrimaryTextBrush}"
                FontSize="14"
                FontWeight="SemiBold"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                MaxWidth="140"
                Margin="0,6,0,2" />
            <TextBlock
                Grid.Row="0"
                Grid.RowSpan="4"
                Text="{Binding EmptyText}"
                Foreground="{ThemeResource AppSecondaryTextBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="140"
                Visibility="{Binding HasAccount, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        </Grid>
    </Border>
</Window>
