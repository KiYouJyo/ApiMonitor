<Window
    x:Class="ApiMonitor.Views.FloatingBalanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApiMonitor.Views.Converters"
    Title="">

    <Grid
        x:Name="RootGrid"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        PointerPressed="OnRootPointerPressed">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </Grid.Resources>

        <!-- 选定账户的核心额度信息（轻量，只显示一个账户） -->
        <Border
            x:Name="DetailPanel"
            Padding="18"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="{ThemeResource AppCardBorderBrush}"
            Background="{ThemeResource AppCardBackgroundBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding AccountName}"
                    Foreground="{ThemeResource AppPrimaryTextBrush}"
                    FontSize="12"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="170" />
                <TextBlock
                    Text="{Binding ProviderName}"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    FontSize="10"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />
                <!-- 数字与单位作为整体缩放，永不裁切单位。 -->
                <Viewbox
                    Stretch="Uniform"
                    MaxWidth="170"
                    MaxHeight="52"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            Text="{Binding BalanceText}"
                            Foreground="{ThemeResource AppPrimaryTextBrush}"
                            FontSize="30"
                            FontWeight="Bold"
                            TextAlignment="Center" />
                        <TextBlock
                            Text="{Binding UnitText}"
                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                            FontSize="12"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4" />
                    </StackPanel>
                </Viewbox>
                <TextBlock
                    Text="{Binding StatusText}"
                    Foreground="{ThemeResource AppPrimaryTextBrush}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="170" />
            </StackPanel>
        </Border>

        <!-- 空状态：无账户或当前选定账户不可用 -->
        <TextBlock
            Text="{Binding EmptyText}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource AppSecondaryTextBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="176"
            Visibility="{Binding HasAccount, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
    </Grid>
</Window>
